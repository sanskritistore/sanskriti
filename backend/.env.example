# संस्कृति बैकएंड - पर्यावरण वेरिएबल नमूना
# उपयोग: cp .env.example .env  फिर मान भरें

# ── एप्लीकेशन ──────────────────────────────
APP_ENV=development
DEBUG=true
CORS_ORIGINS=["http://localhost:3000"]

# ── डेटाबेस (PostgreSQL) ────────────────────
# Docker Compose के अंदर host "db" है, बाहर से "localhost"
DATABASE_URL=postgresql+asyncpg://sanskriti:sanskriti@db:5432/sanskriti
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ── Redis ───────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── JWT / सुरक्षा ────────────────────────────
# उत्पादन में कड़ाई से अन्य कुंजी रखें!
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── OTP लॉगिन ─────────────────────────────
OTP_LENGTH=6
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
# डेवलपमेंट में true: OTP API उत्तर में मिलता है (SMS गेटवे के बिना टेस्ट)
# उत्पादन में कड़ाई से false रखें!
OTP_DEV_MODE=true

# ── Meta (Facebook/Instagram) ────────────────
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_ACCESS_TOKEN=your-meta-access-token
META_API_VERSION=v21.0

# ── Google Ads (भविष्य) ─────────────────────
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=

# ── AI (विज्ञापन निर्माण) ────────────────────
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini

# ── WhatsApp Business API ────────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=my-verify-token

# ── भुगतान (UPI/Razorpay) ──────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
UPI_VPA=sanskriti@upi
