# Sanskriti Frontend Environment Variables
# Copy this file to .env.local and fill in the values

# Backend API base URL (no trailing slash)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Full API versioned endpoint (usually API_BASE_URL + /api/v1)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# App
NEXT_PUBLIC_APP_NAME=Sanskriti
NEXT_PUBLIC_DEFAULT_LANGUAGE=hi

# WhatsApp share endpoint (for ad sharing, if used)
NEXT_PUBLIC_WHATSAPP_NUMBER=
